<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:componentes="clr-namespace:Tiendara.CapaVisual.Componentes"
             x:Class="Tiendara.CapaVisual.tiendaradueno_home"
             BackgroundImageSource="fondo_registro.png"
             BackgroundColor="Black"
             Padding="0">

    <Grid>

        <!-- Contenido principal -->
        <Grid x:Name="mainContent" Padding="20">
            <VerticalStackLayout>
                <Label Text="Bienvenido, Tiendara Pro"
                       FontSize="14"
                       TextColor="Gold"
                       FontAttributes="Bold"
                       Margin="10,30,0,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ✅ Menu completo (incluye el botón hamburguesa dentro) -->
        <componentes:MenuLateralTiendara x:Name="menuLateral" />

    </Grid>
</ContentPage>
