<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tiendara.CapaVisual.Componentes.MenuLateralTiendara"
             x:Name="this">

    <AbsoluteLayout>

        <!-- 🔸 Botón hamburguesa flotante SIEMPRE visible -->
        <Label x:Name="btnHamburguesa"
               Text="≡"
               FontSize="32"
               TextColor="Gold"
               Margin="15"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               ZIndex="200"
               InputTransparent="False"
               AbsoluteLayout.LayoutBounds="0,0,50,50"
               AbsoluteLayout.LayoutFlags="None"/>

        <!-- 🔹 Menú lateral deslizable -->
        <Grid x:Name="menuLateral"
              BackgroundColor="#222"
              WidthRequest="250"
              IsVisible="False"
              Padding="20"
              TranslationX="-250"
              ZIndex="99"
              AbsoluteLayout.LayoutBounds="0,0,250,1"
              AbsoluteLayout.LayoutFlags="PositionProportional,HeightProportional">

            <VerticalStackLayout Spacing="15">

                <Label Text="←"
                       FontSize="28"
                       TextColor="Gold"
                       HorizontalOptions="Start"
                       x:Name="btnCerrarMenu"/>

                <Label Text="Menú Tiendara"
                       FontSize="20"
                       TextColor="Gold"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Button x:Name="btnPerfil" Text="Perfil" Style="{StaticResource BotonTiendara}" />
                <Button Text="Perfil tienda" Style="{StaticResource BotonTiendara}" />
                <Button Text="Empleados" Style="{StaticResource BotonTiendara}" />

                <!-- 👇 Necesitamos nombre para enganchar el click -->
                <Button x:Name="btnMapa" Text="Mapa" Style="{StaticResource BotonTiendara}" />

                <Button Text="Inventario" Style="{StaticResource BotonTiendara}" />
                <Button Text="Chat" Style="{StaticResource BotonTiendara}" />
                <Button Text="VIP" Style="{StaticResource BotonTiendara}" />
                <Button Text="Retiros" Style="{StaticResource BotonTiendara}" />
                <Button x:Name="btnEstadoTienda" Text="Abrir tienda" Style="{StaticResource BotonTiendara}" />
                <Button Text="Ayuda" Style="{StaticResource BotonTiendara}" />

            </VerticalStackLayout>
        </Grid>

        <!-- 🧭 PANEL MAPA (flotante, no pantalla completa) -->
        <Border x:Name="panelMapa"
                IsVisible="False"
                BackgroundColor="#1E1E1E"
                Stroke="#444" StrokeThickness="1"
                WidthRequest="360" HeightRequest="360"
                ZIndex="150"
                AbsoluteLayout.LayoutBounds="1,1,360,360"
                AbsoluteLayout.LayoutFlags="PositionProportional">

            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid Padding="8" BackgroundColor="#262626">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Text="Mapa (beta)" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="✕"
                           Grid.Column="1"
                           TextColor="White"
                           FontSize="18"
                           Padding="6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarPanelMapaTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- 👇 Mapa con WebView (Leaflet) -->
                <WebView x:Name="webMapa"
                         Grid.Row="1"
                         VerticalOptions="FillAndExpand"
                         HorizontalOptions="FillAndExpand" />
            </Grid>
        </Border>

    </AbsoluteLayout>
</ContentView>
