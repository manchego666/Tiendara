<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Tiendara.CapaVisual.Componentes.Publicaciones.PublicacionesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ====== Tokens locales ====== -->
    <ContentView.Resources>
        <Color x:Key="Glass">#E8121314</Color>
        <!-- #121314 con ~92% -->
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#B0B0B0</Color>
        <Color x:Key="BorderDim">#333333</Color>

        <!-- Styles compactos -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="Stroke" Value="{StaticResource BorderDim}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="20"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionIcon" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="WidthRequest" Value="28"/>
            <Setter Property="HeightRequest" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="AvatarFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="HeightRequest" Value="36"/>
            <Setter Property="WidthRequest" Value="36"/>
            <Setter Property="BackgroundColor" Value="#2A2A2A"/>
        </Style>
    </ContentView.Resources>

    <!-- ====== Layout general ====== -->
    <Grid RowDefinitions="Auto,*" BackgroundColor="#0D0F15">

        <!-- ===== Composer ===== -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="12,8,12,6">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="22" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">
                <!-- Entrada + acciones derechas -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry x:Name="txtPost"
                           Placeholder="¿Qué deseas publicar?"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="#9AA0A6"
                           BackgroundColor="#1A1D21"
                           HeightRequest="40"
                           Margin="0"
                           />
                    <ImageButton Grid.Column="1"
                                 Source="ic_photo_idle.png"
                                 Style="{StaticResource ActionIcon}"
                                 Clicked="OnAdjuntarClicked"/>
                    <Button Grid.Column="2"
                            x:Name="btnPublicar"
                            Text="Publicar"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="#1E2329"
                            CornerRadius="16"
                            Padding="16,8"
                            Clicked="OnPublicarClicked"/>
                </Grid>

                <!-- Preview de imagen adjunta -->
                <Grid x:Name="panelPreview" IsVisible="False">
                    <Border Style="{StaticResource GlassCard}" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Image x:Name="imgPreview" Aspect="AspectFill" HeightRequest="160"/>
                    </Border>

                    <!-- Botón X flotante -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ImageButton Grid.Row="0" Grid.Column="1"
                                     Source="ic_close_idle.png"
                                     BackgroundColor="#66000000"
                                     CornerRadius="14"
                                     WidthRequest="28" HeightRequest="28"
                                     Margin="8"
                                     Clicked="OnQuitarImagenClicked"/>
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ===== Feed ===== -->
        <CollectionView Grid.Row="1"
                        x:Name="lista"
                        ItemsSource="{Binding Items}"
                        BackgroundColor="#0D0F15">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6">
                    <Label Text="Aún no hay publicaciones."
                           TextColor="#999" HorizontalOptions="Center"/>
                    <Label Text="Escribe algo arriba y toca Publicar."
                           TextColor="#666" HorizontalOptions="Center" FontSize="12"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GlassCard}" Margin="12,6">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Radius="22" Offset="0,8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <!-- Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Frame Style="{StaticResource AvatarFrame}">
                                    <!-- Si luego agregas AvatarPath en tu VM, cámbialo aquí -->
                                    <Image Source="avatar_default.png" Aspect="AspectFill"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="{Binding AutorLinea}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding TiempoRelativo}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="11"/>
                                </VerticalStackLayout>

                                <ImageButton Grid.Column="2"
                                             Source="ic_more_idle.png"
                                             Style="{StaticResource ActionIcon}"/>
                            </Grid>

                            <!-- Texto -->
                            <Label Text="{Binding Texto}"
                                   TextColor="#EDEDED"
                                   LineBreakMode="WordWrap"/>

                            <!-- Imagen opcional (con esquinas redondas) -->
                            <Border IsVisible="{Binding TieneImagen}"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Image Source="{Binding ImagenPath}"
                                       Aspect="AspectFill"
                                       HeightRequest="280"/>
                            </Border>

                            <!-- Acciones -->
                            <HorizontalStackLayout Spacing="18" Margin="0,2,0,0">
                                <ImageButton Source="ic_comment_idle.png"
                                             Style="{StaticResource ActionIcon}"
                                             Clicked="OnCommentClicked"/>
                                <ImageButton Source="ic_contact_idle.png"
                                             Style="{StaticResource ActionIcon}"
                                             Clicked="OnContactClicked"/>
                                <ImageButton Source="ic_profile_idle.png"
                                             Style="{StaticResource ActionIcon}"
                                             Clicked="OnProfileClicked"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
