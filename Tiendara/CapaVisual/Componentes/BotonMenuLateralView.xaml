<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Tiendara.CapaVisual.Componentes.BotonMenuLateralView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- look “glass” para que combine con el panel -->
    <Frame CornerRadius="22"
       Padding="0"
       BackgroundColor="#1A0B0B0C">
        <Frame.Shadow>
            <Shadow Brush="Black" Opacity="0.25" Radius="18" Offset="0,8"/>
        </Frame.Shadow>

        <ImageButton Source="tiendara_botonmenu.png"
                 WidthRequest="52"
                 HeightRequest="52"
                 BackgroundColor="Transparent"
                 Clicked="OnClicked"/>
    </Frame>

</ContentView>
