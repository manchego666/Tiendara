<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Tiendara.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:Tiendara.CapaVisual.Autenticacion"
    xmlns:pages="clr-namespace:Tiendara.CapaVisual.PaginasModulo"
    FlyoutBehavior="Disabled"
    NavBarIsVisible="False">

    <!-- Login PRIMERO para que sea la pantalla inicial -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate auth:RegistroInicioPage}" />

    <!-- Home después; navegamos aquí solo cuando el login sea correcto -->
    <ShellContent Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
</Shell>
