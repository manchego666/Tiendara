<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tiendara.MainPage"
             BackgroundColor="LightGreen">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- TÍTULO -->
            <Label Text="Tiendara"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black"/>

            <!-- BOTONES BÁSICOS -->
            <Button Text="Inventario" />
            <Button Text="Registrar venta" />
            <Button Text="Corte de caja" />
            <Button Text="Empleados" />
            <Button Text="Proveedores" />
            <Button Text="Cerrar sesión" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
