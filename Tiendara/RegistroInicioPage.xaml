<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tiendara.RegistroInicioPage"
             BackgroundImageSource="fondo_registro.png">
    <Grid>
        <Frame x:Name="frameTutorial"
       BorderColor="Gold"
       CornerRadius="10"
       IsVisible="True"
       Padding="10"
       HasShadow="False"
       BackgroundColor="Transparent"
       HorizontalOptions="Center"
       VerticalOptions="Start"
       Margin="0,50,0,0">

            <ContentView x:Name="contenedorAnimado">
                <Label x:Name="lblMensajeTutorial"
               Text="Bienvenido a Tiendara. Una app donde podrás administrar tus negocios de forma sencilla y barata."
               FontSize="24"
               FontAttributes="Bold"
               TextColor="Gold"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
            </ContentView>
        </Frame>






        <!-- Botón que aparece después -->
        <Button x:Name="btnMostrarRegistro"
                Text="Registrarse"
                BackgroundColor="Gold"
                TextColor="Black"
                Clicked="MostrarFormulario"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,100"
                IsVisible="False"/>

        <!-- FORMULARIO REGISTRO -->
        <ScrollView IsVisible="False" x:Name="panelFormulario">
            <VerticalStackLayout Padding="30" Spacing="20">
                <Entry Placeholder="Nombre" x:Name="entryNombre"/>
                <Entry Placeholder="Correo" x:Name="entryCorreo"/>
                <Entry Placeholder="Contraseña" IsPassword="True" x:Name="entryPassword"/>
                <Entry Placeholder="Teléfono" x:Name="entryTelefono"/>

                <Button Text="Registrarse"
                        BackgroundColor="Gold"
                        TextColor="Black"
                        Clicked="OnRegistrarseClicked"/>

                <Button Text="¿Ya tienes cuenta? Inicia sesión"
                        Clicked="btnIniciarSesion_Clicked"
                        BackgroundColor="Transparent"
                        TextColor="White"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

