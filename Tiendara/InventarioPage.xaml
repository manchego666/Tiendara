<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tiendara.InventarioPage"
             Title="Inventario"
             BackgroundColor="LightGreen">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Inventario - Registro de productos"
                   FontSize="20"
                   HorizontalOptions="Center" />

            <Entry x:Name="txtNombre" Placeholder="Nombre del producto"/>
            <Entry x:Name="txtMarca" Placeholder="Marca"/>
            <Entry x:Name="txtTipo" Placeholder="Tipo"/>
            <Entry x:Name="txtCodigo" Placeholder="Código de barras" />
            <Entry x:Name="txtProveedor" Placeholder="Proveedor" />
            <Entry x:Name="txtPrecioCompra" Placeholder="Precio de compra" Keyboard="Numeric" />
            <Entry x:Name="txtPrecioVenta" Placeholder="Precio de venta" Keyboard="Numeric" />
            <Entry x:Name="txtStock" Placeholder="Stock (cantidad disponible)" Keyboard="Numeric" />
            <Entry x:Name="txtUnidad" Placeholder="Unidad (pieza, litro...)" />
            <Entry x:Name="txtContenido" Placeholder="Contenido neto (g, kg...)" />

            <Button Text="Guardar producto" Clicked="OnGuardarClicked" />
            
            <Label Text="Productos actuales:" FontAttributes="Bold" Margin="0,20,0,0" />
            <CollectionView x:Name="listaProductos" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem
                            Text="Eliminar"
                            BackgroundColor="Red"
                            Invoked="OnEliminarProducto"
                            CommandParameter="{Binding ID}" />
                                    <SwipeItem
                            Text="Editar"
                            BackgroundColor="Orange"
                            Invoked="OnEditarProducto"
                            CommandParameter="{Binding ID}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="10" BackgroundColor="White" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="Black" Grid.Row="0"/>
                                <Label Text="{Binding Marca}" FontSize="14" TextColor="Gray" Grid.Row="1"/>
                                <Label Text="{Binding PrecioVenta, StringFormat='Precio: {0:C}'}" FontSize="14" TextColor="Green" Grid.Row="2"/>

                                <!-- Botones visibles para escritorio -->
                                <StackLayout Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalOptions="End">
                                    <Button Text="Editar"
                                Clicked="OnEditarProducto"
                                CommandParameter="{Binding ID}"
                                BackgroundColor="Orange"
                                TextColor="White" />
                                    <Button Text="Borrar"
                                Clicked="OnEliminarProducto"
                                CommandParameter="{Binding ID}"
                                BackgroundColor="Red"
                                TextColor="White" />
                                </StackLayout>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
